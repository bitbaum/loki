# Agent scratch under .claude/ stays local, but the shared session-start hook and
# settings are part of the repo: they are what makes Claude Code on the web able
# to install this project's GitHub-hosted dependencies at all.
.claude/*
!.claude/settings.json
!.claude/hooks/
*.tsbuildinfo
.playwright-mcp/
.tmp/
*.png
*.jpeg
.local-toolchain/
.python-vendor/
next-env.d.ts
**/__pycache__/
*.pyc
.vercel
.env.vercel.production
/backups/
/cockpit.service
/codex-wrapper
# Desktop app (Fleet Runner) subproject
desktop/node_modules
desktop/dist
desktop/out
desktop/.vite
desktop/.turbo
# AppImage extraction artifact — created by `./Fleet-Runner-*.AppImage
# --appimage-extract` for debugging. Bulky (~300 MB), never useful to
# commit, and Next.js's output: "standalone" tracer was bundling it into
# every serverless function before next.config's outputFileTracingExcludes
# caught it.
squashfs-root/
# Brand icons (regenerated by desktop/scripts/generate-tray-icon.mjs but
# committed so packaged binaries include them without a generation step).
!desktop/resources/*.png
# ...including the Linux installer icon set, which electron-builder reads as a
# directory of <size>x<size>.png at package time. Same deal: generated by
# `npm run generate:brand`, committed so the desktop build stays dependency-free.
!desktop/resources/icons/*.png

# Thoughts essay assets — product screenshots referenced by content/thoughts/*.md.
!public/thoughts/*.png

.env.vercel.production.snapshot.OLD
/public/widget.js

# Scratch files used to compose commit messages and PR bodies (never content).
.commitmsg
.prbody

# A clone of this repo, inside this repo.
#
# `loki-apps/` is 1.1 GB and its remote is bitbaum/loki — the same
# repository it sits inside. It carried nothing unique (clean tree, nothing
# unpushed), but it was untracked AND unignored, so `git add -A` would have
# tried to commit it. Ignored rather than deleted: a redundant working copy is
# still someone's working copy.
/loki-apps/

# Vendored binaries under desktop/resources/bin/ — never commit.
#
# The .png negations above deliberately COMMIT generated brand icons so the
# desktop build stays dependency-free. A 35 MB executable is the opposite case:
# `desktop/resources/bin/zellij` (Nov 2024) sat here untracked and unignored,
# referenced by nothing in desktop/ — one `git add -A` from landing 35 MB of
# binary in a public repository's history, where it could not be removed
# without a rewrite.
desktop/resources/bin/
