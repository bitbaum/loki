# LOKI_REPO_ROOT=            # src/lib/site-cd-local.ts
# LOKI_SANDBOX_DOCKER_ARGS=            # src/lib/agent-execution/sandbox.ts
# LOKI_SITES_BASE_DOMAIN=            # src/lib/site-cd.ts
# LOKI_SITE_CD_AUTO=            # src/lib/site-cd-local.ts
