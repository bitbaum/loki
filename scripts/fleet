#!/usr/bin/env bash
# fleet — Friendly local wrapper for Loki development and daily use.
# Valid both in a checkout's scripts/ directory and when extracted flat into
# ~/.local/share/loki/ by the hosted installer.
#
# Recommended: symlink as "fc" (or keep "cpit" during transition):
#   ln -s /home/g/dev/loki/scripts/fleet ~/bin/fc
#
# Examples:
#   fc daemon start
#   fc install-agent grok
#   fc status
#   fc pause
#   fc resume

set -euo pipefail

RUNTIME_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$RUNTIME_DIR/loki-daemon.sh" ]; then
  echo "Loki helper is incomplete at $RUNTIME_DIR. Re-run the installer from Settings." >&2
  exit 1
fi
DAEMON_SCRIPT="$RUNTIME_DIR/loki-daemon.sh"
INSTALL_SCRIPT="$RUNTIME_DIR/install-loki-daemon.sh"

# Load env if present (the one from the installer). Support both the new
# LOKI_ layout and legacy COCKPIT_ location during transition.
if [ -f "$HOME/.config/loki/daemon.env" ]; then
  set -a
  source "$HOME/.config/loki/daemon.env"
  set +a
elif [ -f "$HOME/.config/loki/daemon.env" ]; then
  set -a
  source "$HOME/.config/loki/daemon.env"
  set +a
fi

# Force remote for production Control when you also run a local dev server
export APP_DAEMON_FORCE_REMOTE=1
export LOKI_DAEMON_FORCE_REMOTE=1
export COCKPIT_DAEMON_FORCE_REMOTE=1

case "${1:-help}" in
  daemon|d)
    shift
    case "${1:-start}" in
      start)
        if systemctl --user is-enabled loki-daemon >/dev/null 2>&1; then
          echo "Starting via systemd (recommended)…"
          bash "$INSTALL_SCRIPT" --restart 2>/dev/null || systemctl --user restart loki-daemon
        else
          echo "Starting daemon (no systemd service — run: fleet service enable)…"
          pkill -f 'loki-daemon.sh' 2>/dev/null || true
          sleep 0.5
          nohup bash "$DAEMON_SCRIPT" >> "${HOME}/.local/state/loki/daemon.log" 2>&1 &
          sleep 1
          pgrep -f 'loki-daemon.sh' >/dev/null && echo "Daemon started." || echo "Daemon failed to start — check log."
        fi
        ;;
      stop)
        if systemctl --user is-enabled loki-daemon >/dev/null 2>&1; then
          systemctl --user stop loki-daemon
        fi
        pkill -f 'loki-daemon.sh' 2>/dev/null || true
        echo "Daemon stopped."
        ;;
      restart)
        if systemctl --user is-enabled loki-daemon >/dev/null 2>&1; then
          bash "$INSTALL_SCRIPT" --restart
        else
          $0 daemon stop
          sleep 1
          $0 daemon start
        fi
        ;;
      *)
        echo "Usage: fleet daemon {start|stop|restart}"
        ;;
    esac
    ;;
  install-agent|ia)
    agent="${2:-}"
    if [ -z "$agent" ]; then
      echo "Usage: fleet install-agent <grok|claude|cursor|gemini>"
      exit 1
    fi
    echo "Triggering one-click install for $agent (will open a tab if daemon running)..."
    # This calls the production API — requires the daemon token (prefer new LOKI_, fall back)
    TOKEN="${LOKI_DAEMON_TOKEN:-${COCKPIT_DAEMON_TOKEN:-}}"
    if [ -z "$TOKEN" ]; then
      echo "No LOKI_DAEMON_TOKEN (or legacy COCKPIT_DAEMON_TOKEN) found. Source your daemon.env first."
      exit 1
    fi
    auth_header="$(mktemp)"
    chmod 600 "$auth_header"
    printf 'Authorization: Bearer %s\n' "$TOKEN" > "$auth_header"
    trap 'rm -f "$auth_header"' EXIT
    curl -s -X POST "https://loki.orangecat.ch/api/agent/install-cli" \
      -H "@$auth_header" \
      -H "Content-Type: application/json" \
      -d "{\"agent\":\"$agent\"}" | jq .
    echo "The installer runs in a terminal Fleet Runner owns — watch it on Control → This computer."
    ;;
  status|s)
    echo "=== Running daemons ==="
    pgrep -f 'loki-daemon.sh' -a || echo "None"
    echo ""
    echo "=== Systemd user service ==="
    systemctl --user status loki-daemon 2>/dev/null || echo "Service not installed (run: ./scripts/install-loki-daemon.sh)"
    echo ""
    echo "=== Recent runtime state (if any) ==="
    ls -lt /tmp/agent-current-prompt-* /tmp/agent-ready-* 2>/dev/null | head -5 || echo "No recent sentinels"
    echo "=== Your projects ==="
    grep -E '^(Loki|revamp|OrangeCat)' "$HOME/.config/agent-projects.conf" 2>/dev/null || echo "No conf"
    ;;
  service)
    shift
    case "${1:-status}" in
      enable|install)
        echo "Installing/enabling background service..."
        bash "$INSTALL_SCRIPT"
        ;;
      disable)
        echo "Disabling service..."
        systemctl --user disable --now loki-daemon 2>/dev/null || true
        ;;
      status)
        systemctl --user status loki-daemon 2>/dev/null || echo "Not installed"
        ;;
      *)
        echo "Usage: fleet service {enable|disable|status}"
        ;;
    esac
    ;;
  pause)
    touch "/tmp/loki-pause"
    echo "Fleet paused (daemon will respect this on next cycle)."
    ;;
  resume)
    rm -f "/tmp/loki-pause"
    echo "Fleet resumed."
    ;;
  help|*)
    echo "fleet — your friendly local Loki helper"
    echo ""
    echo "Recommended name: fc (or cpit during transition to avoid conflicts)"
    echo ""
    echo "Commands:"
    echo "  fc daemon start          # Clean start against production"
    echo "  fc daemon stop"
    echo "  fc install-agent grok    # Opens a tab and injects the installer"
    echo "  fc status"
    echo "  fc pause / resume        # Low-power mode"
    echo ""
    echo "Setup (recommended):"
    echo "  ln -s $(readlink -f "$0") ~/bin/fc"
    echo ""
    echo "Then just use: fc daemon start"
    ;;
esac
