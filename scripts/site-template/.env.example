# Every variable this app reads, with what it is for. Real values live in the
# box env (/opt/__SLUG__/shared/.env) — never in git. Leaving an optional one
# empty switches its feature OFF and hides it; it never breaks a page.

# ── Required in production ─────────────────────────────────────────────────
# Postgres for accounts and everything else. /api/health is red without it.
DATABASE_URL=
# Signs sessions and encrypts 2FA secrets. 32+ random characters:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=
# The public origin. Defaults to https://__HOST__.
NEXT_PUBLIC_APP_URL=

# ── Secrets at rest ────────────────────────────────────────────────────────
# Seals people's own model keys (ai-kit seal, AES-256-GCM). 32+ characters.
# Without it, "Your own model" says it is not switched on.
SECRET_SEAL_KEY=

# ── Mail (@bitbaum/mail-kit) ───────────────────────────────────────────────
# With both set: email verification is required and sign-in links work.
# Without: password sign-up signs in directly and the link option is hidden.
RESEND_API_KEY=
RESEND_FROM=

# ── Sign in with the shared bitbaum sign-in (Google, Apple, GitHub, X, Meta) ─
# All three, or the button stays hidden. OIDC, client_secret_post + PKCE.
SIGNIN_ISSUER=
SIGNIN_CLIENT_ID=
SIGNIN_CLIENT_SECRET=

# ── Sign in with OrangeCat ─────────────────────────────────────────────────
# Both, or the button stays hidden. Register the client in orangecat's
# scripts/oauth/register-client.ts. Issuer defaults to https://orangecat.ch.
ORANGECAT_OAUTH_CLIENT_ID=
ORANGECAT_OAUTH_CLIENT_SECRET=
ORANGECAT_OAUTH_ISSUER=

# ── The shared free model chain (@bitbaum/ai-kit) ──────────────────────────
# Any one switches the example model route on. APP_MODEL optionally picks
# where in the chain to start; it is never a pin.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
APP_MODEL=

# ── Loki ───────────────────────────────────────────────────────────────────
# Written by Loki when the site is scaffolded. The widget lets the owner point
# at the page and ask for a change.
NEXT_PUBLIC_FC_WIDGET_TOKEN=
NEXT_PUBLIC_FC_PROJECT_ID=
NEXT_PUBLIC_OC_PROJECT_ID=
